<?xml version="1.0" encoding="utf-8"?>
<ExtensionInfo
    xmlns:android="http://schemas.android.com/apk/res/android"
    id="karoobbrakers"
    version="1.2.1"
    displayName="@string/extension_name"
    icon="@drawable/ic_brake_sense"
    scansDevices="false"
    fitFile="true">

    <DataType
        typeId="current_decel"
        displayName="@string/type_current_decel"
        description="@string/desc_current_decel"
        icon="@drawable/ic_brake_sense"
        graphical="true" />

    <DataType
        typeId="braking_power"
        displayName="@string/type_braking_power"
        description="@string/desc_braking_power"
        icon="@drawable/ic_brake_power"
        graphical="true" />

    <DataType
        typeId="max_decel"
        displayName="@string/type_max_decel"
        description="@string/desc_max_decel"
        icon="@drawable/ic_brake_sense"
        graphical="true" />

    <DataType
        typeId="brake_events"
        displayName="@string/type_brake_events"
        description="@string/desc_brake_events"
        icon="@drawable/ic_brake_sense"
        graphical="true" />

    <DataType
        typeId="brake_energy"
        displayName="@string/type_brake_energy"
        description="@string/desc_brake_energy"
        icon="@drawable/ic_wear"
        graphical="true" />

    <DataType
        typeId="pad_wear"
        displayName="@string/type_pad_wear"
        description="@string/desc_pad_wear"
        icon="@drawable/ic_wear"
        graphical="true" />

    <DataType
        typeId="brake_temperature"
        displayName="@string/type_brake_temperature"
        description="@string/desc_brake_temperature"
        icon="@drawable/ic_wear"
        graphical="true" />

    <DataType
        typeId="descent_efficiency"
        displayName="@string/type_descent_efficiency"
        description="@string/desc_descent_efficiency"
        icon="@drawable/ic_brake_gauge"
        graphical="true" />

    <DataType
        typeId="pad_life"
        displayName="@string/type_pad_life"
        description="@string/desc_pad_life"
        icon="@drawable/ic_wear"
        graphical="true" />

    <DataType
        typeId="wasted_watts"
        displayName="@string/type_wasted_watts"
        description="@string/desc_wasted_watts"
        icon="@drawable/ic_brake_power"
        graphical="true" />

    <DataType
        typeId="grip_margin"
        displayName="@string/type_grip_margin"
        description="@string/desc_grip_margin"
        icon="@drawable/ic_brake_sense"
        graphical="true" />

    <DataType
        typeId="graphical_brake"
        displayName="@string/type_graphical_brake"
        description="@string/desc_graphical_brake"
        icon="@drawable/ic_brake_gauge"
