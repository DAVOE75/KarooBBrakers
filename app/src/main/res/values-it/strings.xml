    <!-- Guida Utente -->
    <string name="guide_step1">1. Apri un Profilo Corsa nelle impostazioni del Karoo.</string>
    <string name="guide_step2">2. Modifica una schermata dati e seleziona uno spazio vuoto.</string>
    <string name="guide_step3">3. Nella sezione \'Karoo BBrakers\', scegli il campo numerico o grafico.</string>
    <string name="guide_step4">4. I dati vengono registrati nel file FIT per Strava e Intervals.icu.</string>

