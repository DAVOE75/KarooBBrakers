    <!-- Guide d\'Utilisation -->
    <string name="guide_step1">1. Ouvrez un profil de parcours dans les paramètres Karoo.</string>
    <string name="guide_step2">2. Modifiez une page de données et touchez un champ vide.</string>
    <string name="guide_step3">3. Dans la section \'Karoo BBrakers\', choisissez votre métrique préférée.</string>
    <string name="guide_step4">4. Les données sont enregistrées dans le fichier FIT pour Strava &amp; Intervals.icu.</string>
