    <!-- Guide Utilisateur -->
    <string name="guide_step1">1. Ouvrez un profil de sortie dans les paramètres du Karoo.</string>
    <string name="guide_step2">2. Modifiez une page de données et sélectionnez un emplacement libre.</string>
    <string name="guide_step3">3. Dans la section \'Karoo BBrakers\', choisissez la valeur ou le graphique souhaité.</string>
    <string name="guide_step4">4. Les données sont sauvegardées dans le fichier FIT pour Strava et Intervals.icu.</string>

